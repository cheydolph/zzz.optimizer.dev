{
  "name": "zzz.optimizer",
  "version": "7.0.16",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "thumbs": "node build-scripts/generate-agent-thumbnails.js",
    "validate:data": "node build-scripts/validate-agent-data.js",
    "slim:data": "node build-scripts/slim-agent-data.js slim",
    "restore:data": "node build-scripts/slim-agent-data.js restore",
    "build": "npm run validate:data && npm run thumbs && node build-scripts/slim-agent-data.js run -- ng build",
    "build:local": "npm run validate:data && npm run thumbs && node build-scripts/slim-agent-data.js run -- ng build --configuration production --base-href ./",
    "serve:local": "node build-scripts/serve-local.js",
    "start:local": "npm run build:local && node build-scripts/serve-local.js",
    "build:ghpages": "npm run validate:data && npm run thumbs && node build-scripts/slim-agent-data.js run -- ng build --configuration=github-pages",
    "deploy:ghpages": "npm run build:ghpages && npx angular-cli-ghpages --dir=dist/zzz.optimizer/browser --no-silent",
    "deploy:cleanup": "npm run build:ghpages && node -e \"require('fs').copyFileSync('dist/zzz.optimizer/browser/safety-worker.js', 'dist/zzz.optimizer/browser/ngsw-worker.js')\" && npx angular-cli-ghpages --dir=dist/zzz.optimizer/browser --no-silent",
    "watch": "ng build --watch --configuration=development",
    "test": "ng test",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.25",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@angular/service-worker": "^21.2.25",
    "canvas-confetti": "^1.9.4",
    "dexie": "^4.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.25",
    "@biomejs/biome": "2.6.3",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.2",
    "angular-cli-ghpages": "^3.0.2",
    "esbuild": "0.25.4",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.15",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@angular-devkit/core@21": {
      "chokidar": "^5.0.0"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.4": true,
    "lmdb": false,
    "msgpackr-extract": false,
    "@parcel/watcher": false,
    "esbuild@0.28.2": true
  }
}
