{
  "name": "zzz.optimizer",
  "version": "7.0.15",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "thumbs": "node build-scripts/generate-agent-thumbnails.js",
    "validate:data": "node build-scripts/validate-agent-data.js",
    "build": "npm run validate:data && npm run thumbs && ng build",
    "build:ghpages": "npm run validate:data && npm run thumbs && ng build --configuration=github-pages",
    "deploy:ghpages": "npm run build:ghpages && npx angular-cli-ghpages --dir=dist/zzz.optimizer/browser --no-silent",
    "deploy:cleanup": "npm run build:ghpages && node -e \"require('fs').copyFileSync('dist/zzz.optimizer/browser/safety-worker.js', 'dist/zzz.optimizer/browser/ngsw-worker.js')\" && npx angular-cli-ghpages --dir=dist/zzz.optimizer/browser --no-silent",
    "watch": "ng build --watch --configuration=development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.25",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@angular/service-worker": "^21.2.25",
    "canvas-confetti": "^1.9.4",
    "dexie": "^4.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.28",
    "@angular/cli": "^21.2.28",
    "@angular/compiler-cli": "^21.2.25",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^24.19.2",
    "angular-cli-ghpages": "^3.0.2",
    "esbuild": "0.25.4",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.15",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.3",
    "webpack-bundle-analyzer": "^5.2.0"
  },
  "overrides": {
    "@angular-devkit/core@21": {
      "chokidar": "^5.0.0"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.4": true,
    "lmdb": false,
    "msgpackr-extract": false,
    "@parcel/watcher": false,
    "esbuild@0.28.2": true
  }
}
